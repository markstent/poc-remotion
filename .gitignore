# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets
.env
.env.*
!.env.example

# Local AI configuration
.ai-project

# Local datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated voice samples: never commit audio
data/voice_samples/

# macOS
.DS_Store

# Superpowers brainstorm sessions
.superpowers/

# Isolated worktrees
.worktrees/

# Node
node_modules/

# Licensed font binaries: licence unconfirmed, keep out of Git
src/fonts/

# Renderer staging (per-project data + audio, embedded at build time) and
# build artefacts. Fonts are copied in from src/fonts by the render step.
renderer/data/*.json
renderer/media/*
!renderer/media/.gitkeep
renderer/target/
renderer/out.mp4
renderer/frames/
projects/
kokoro-v1.0.onnx
voices-v1.0.bin
